<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/khatyar_notification_root_big"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="11dp"
    android:paddingBottom="12dp"
    android:layoutDirection="rtl"
    android:textDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="rtl">

        <TextView
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/khatyar_notification_ptt_background"
            android:text=""
            android:includeFontPadding="false"/>

        <TextView
            android:id="@+id/khatyar_notification_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="فعال • متصل به سرور"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="start"
            android:includeFontPadding="false"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="مرکز بی‌سیم"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp"
            android:includeFontPadding="false"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/khatyar_notification_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="کانال بی‌سیم  •  تاریخ شمسی: ۱۴۰۵/۰۶/۳۰"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
        android:gravity="start"
        android:includeFontPadding="false"/>

    <LinearLayout
        android:id="@+id/khatyar_notification_ptt"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="11dp"
        android:background="@drawable/khatyar_notification_ptt_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:layoutDirection="rtl">

        <ImageView
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:src="@drawable/khatyar_notification_ptt"
            android:contentDescription="@null"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"/>

        <TextView
            android:id="@+id/khatyar_notification_ptt_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="شروع PTT"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:includeFontPadding="false"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="برای فعال‌سازی ارسال صوت، PTT را لمس کنید"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="10sp"
        android:gravity="center"
        android:includeFontPadding="false"/>
</LinearLayout>