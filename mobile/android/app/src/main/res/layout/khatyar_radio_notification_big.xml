<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/khatyar_notification_root_big"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layoutDirection="rtl"
    android:textDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="rtl">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#22C55E"
            android:textSize="15sp"
            android:includeFontPadding="false"
            android:layout_marginStart="7dp"/>

        <TextView
            android:id="@+id/khatyar_notification_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="فعال • متصل به سرور"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="start"
            android:includeFontPadding="false"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="7dp"
        android:layoutDirection="rtl">

        <ImageView
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:src="@android:drawable/ic_menu_my_calendar"
            android:contentDescription="@null"
            android:layout_marginStart="8dp"/>

        <TextView
            android:id="@+id/khatyar_notification_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="تاریخ شمسی: ۱۴۰۵/۰۶/۳۰ • بی‌سیم"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            android:gravity="start"
            android:includeFontPadding="false"/>
    </LinearLayout>

    <TextView
        android:id="@+id/khatyar_notification_ptt"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/shape_drawable"
        android:gravity="center"
        android:text="🎙 PTT"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:includeFontPadding="false"/>
</LinearLayout>
