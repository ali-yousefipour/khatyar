<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/khatyar_notification_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layoutDirection="rtl"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:background="#FFFFFF">

    <Button
        android:id="@+id/khatyar_notification_ptt"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:minWidth="92dp"
        android:text="🎙 PTT"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1A327A"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <TextView
        android:id="@+id/khatyar_notification_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="بی‌سیم خطیار"
        android:textColor="#172033"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center_vertical|right" />
</LinearLayout>
