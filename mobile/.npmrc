# KhatYar dependency policy:
# 1) existing node_modules / local npm cache first (build scripts use --offline)
# 2) Runflare npm mirror for normal/manual installs
# 3) build scripts fall through to additional Iranian mirrors
# 4) npmjs.org is the final public fallback
# Myket is NOT an npm registry. Android/Gradle artifacts use maven.myket.ir
# through mobile/myket.init.gradle instead.
registry=https://mirror-npm.runflare.com/
strict-ssl=true
fetch-retries=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=180000
prefer-offline=true
audit=false
fund=false
