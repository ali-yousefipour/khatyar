# KhatYar dependency policy:
# 1) npm cache is tried first by the build policy (npm --offline)
# 2) Iranian npm mirrors are tried next
# 3) npmjs.org is the final fallback
# Keep this registry Iranian for normal/manual npm commands as well.
registry=https://repo-portal.ito.gov.ir/repo/npm/
strict-ssl=true
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=180000
prefer-offline=true
audit=false
fund=false
