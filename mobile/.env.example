# آدرس وب‌سرویس (سرور/پنل). نمونه: https://taxi-control.mashhad.ir/api
API_BASE=https://app.yousefipour.ir/api
APP_NAME=خطیار
ANDROID_PACKAGE=ir.mashhad.taxicontrol
ANDROID_VERSION_CODE=10373
ANDROID_VERSION_NAME=1.3.73
# نسخهٔ NDK نصب‌شده روی سیستم (باید دقیقاً با یک پوشه زیر Android/Sdk/ndk مطابقت داشته باشد).
ANDROID_NDK_VERSION=27.3.13750724
# قابلیت‌ها
ENABLE_BG_TRACKING=true
# شناسهٔ پروژهٔ EAS (پس از eas init پر می‌شود)
EAS_PROJECT_ID=
