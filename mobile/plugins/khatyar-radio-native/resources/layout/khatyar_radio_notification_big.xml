<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/khatyar_notification_root_big"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layoutDirection="rtl"
    android:textDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="rtl">

        <TextView
            android:id="@+id/khatyar_notification_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="بی‌سیم فعال • متصل"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="start"
            android:includeFontPadding="false"/>

        <TextView
            android:id="@+id/khatyar_notification_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="خطیار • بی‌سیم"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/khatyar_notification_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="امروز"
        android:gravity="start"
        android:textSize="12sp"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/khatyar_notification_identity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="کاربر • سمت"
        android:textStyle="bold"
        android:textSize="13sp"
        android:maxLines="2"
        android:gravity="start"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/khatyar_notification_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="کانال فعال • آماده ارتباط"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="start"
        android:includeFontPadding="false"/>

    <TextView
        android:id="@+id/khatyar_notification_shift"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="زمان سپری‌شده از شیفت: —"
        android:textSize="12sp"
        android:gravity="start"
        android:includeFontPadding="false" />

    <LinearLayout
        android:id="@+id/khatyar_notification_ptt"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/khatyar_notification_ptt_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:layoutDirection="rtl">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/khatyar_notification_ptt"
            android:contentDescription="@null"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/khatyar_notification_ptt_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="صحبت"
            android:textColor="@color/khatyar_notification_button_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:includeFontPadding="false"/>
    </LinearLayout>

    <TextView
        android:id="@+id/khatyar_notification_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="برای ارسال پیام صوتی، دکمه صحبت را لمس کنید"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="11sp"
        android:gravity="center"
        android:includeFontPadding="false"/>
</LinearLayout>
