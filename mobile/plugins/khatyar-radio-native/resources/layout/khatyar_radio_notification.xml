<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/khatyar_notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layoutDirection="rtl"
    android:textDirection="rtl">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="6dp">

        <TextView
            android:id="@+id/khatyar_notification_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="بی‌سیم فعال • متصل"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="start"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"/>

        <TextView
            android:id="@+id/khatyar_notification_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="کانال فعال • آماده ارتباط"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp"
            android:gravity="start"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/khatyar_notification_ptt"
        android:layout_width="96dp"
        android:layout_height="48dp"
        android:background="@drawable/khatyar_notification_ptt_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:layoutDirection="rtl">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/khatyar_notification_ptt"
            android:contentDescription="@null"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:id="@+id/khatyar_notification_ptt_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="صحبت"
            android:textColor="@color/khatyar_notification_button_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:includeFontPadding="false"/>
    </LinearLayout>
</LinearLayout>
