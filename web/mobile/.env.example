# آدرس وب‌سرویس (سرور/پنل). نمونه: https://taxi-control.mashhad.ir/api
API_BASE=https://app.yousefipour.ir/api
APP_NAME=خطیار
ANDROID_PACKAGE=ir.mashhad.taxicontrol
ANDROID_VERSION_CODE=10365
ANDROID_VERSION_NAME=1.3.65
# نسخهٔ NDK نصب‌شده روی سیستم (باید دقیقاً با یک پوشه زیر Android/Sdk/ndk مطابقت داشته باشد).
# اگر خالی/نادرست باشد یا آن نسخه نصب نشده باشد، بیلد با خطای «NDK not found»
# متوقف می‌شود. با دستور زیر نسخه‌های نصب‌شده را ببینید:
#   %ANDROID_HOME%\ndk (در ویندوز) یا از Android Studio > SDK Manager > SDK Tools > NDK
# اگر نصب نیست، همان نسخه را از SDK Manager نصب کنید یا این مقدار را با نسخهٔ
# واقعی نصب‌شده جایگزین کنید.
ANDROID_NDK_VERSION=27.3.13750724
# قابلیت‌ها
ENABLE_BG_TRACKING=true
# شناسهٔ پروژهٔ EAS (پس از eas init پر می‌شود)
EAS_PROJECT_ID=
