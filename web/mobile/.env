# آدرس وب‌سرویس (سرور/پنل)
API_BASE=https://app.yousefipour.ir/api
APP_NAME=خطیار
ANDROID_PACKAGE=ir.mashhad.taxicontrol
ANDROID_VERSION_CODE=10365
# قابلیت‌ها
ENABLE_BG_TRACKING=true
# شناسهٔ پروژهٔ EAS — بعد از اجرای «eas init» این مقدار به‌صورت خودکار در app.config.js/extra پر می‌شود.
# اگر خواستید دستی هم بگذارید، مقدار را اینجا وارد کنید:
EAS_PROJECT_ID=
# نسخهٔ NDK نصب‌شده روی سیستم (از پوشهٔ ...\Android\Sdk\ndk بردارید تا نیازی به دانلود نباشد)
ANDROID_NDK_VERSION=27.3.13750724
ANDROID_VERSION_NAME=1.3.65
# اطلاعات امضای انتشار (Release Signing) — برای ساخت APK نهایی لازم است.
# فایل کلید در credentials/taxi-myket-release.keystore ساخته شده (این پوشه در .gitignore است).
MYKET_STORE_FILE=../credentials/taxi-myket-release.keystore
MYKET_STORE_PASSWORD=@Li09158048604
MYKET_KEY_ALIAS=taxi_myket_release
MYKET_KEY_PASSWORD=@Li09158048604
