# اجازهٔ عبور هدر Authorization به PHP
RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Web App is served through app-shell.php so Android/Web parity screens are injected without rewriting app.html.
RewriteRule ^app\.html$ app-shell.php [QSA,L,NC]

RewriteRule ^api/admin/role-app-items/?$ api/unified-role-app-items.php [QSA,L,NC]
RewriteRule ^api/my/app-items/?$ api/unified-role-app-items.php [QSA,L,NC]
RewriteRule ^api/radio-api\.php$ radio-api-v2.php [QSA,L,NC]
RewriteRule ^api/radio-api-v2\.php$ radio-api-v2.php [QSA,L,NC]
RewriteRule ^api/radio-admin-api\.php$ radio-admin-api.php [QSA,L,NC]
RewriteRule ^radio-api\.php$ radio-api-v2.php [QSA,L,NC]
RewriteRule ^api/station-wizard-api\.php$ station-wizard-api.php [QSA,L,NC]
RewriteRule ^api/station-missing-line-api\.php$ station-missing-line-api.php [QSA,L,NC]
# مسیر پنل /api/presence-immediate-api.php را به entrypoint پایدار ریشه هدایت می‌کنیم؛
# این کار روی هاست‌هایی که deploy آن‌ها فایل‌های api/ را متفاوت publish می‌کند، خطای 404 را حذف می‌کند.
RewriteRule ^api/presence-immediate-api\.php$ presence-immediate-api.php [QSA,L,NC]
RewriteRule ^presence-immediate-api\.php$ api/presence-immediate-api.php [QSA,L,NC]
RewriteRule ^api/company-request-support\.php$ api/company-request-support.php [QSA,L,NC]

# گزارش‌های مدیریتی از Router اصلی سامانه عبور می‌کنند؛ این مسیرها احراز هویت، نشست و مدیریت خطا را در index.php حفظ می‌کنند.
# عمداً هیچ Rewrite مستقیمی برای attendance-report و users/export وجود ندارد.

RewriteCond %{QUERY_STRING} (^|&)op=capture-report(&|$) [NC]
RewriteRule ^line-station-api\.php$ station-capture-report.php [QSA,L]
RewriteRule ^line-station-api\.php$ line-station-api-v2.php [QSA,L]
RewriteRule ^uploads/line-locations(?:/|$) - [F,L,NC]
RewriteRule ^uploads/radio(?:/|$) - [F,L,NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteRule ^ index.php [QSA,L]
DirectoryIndex index.php
Options -Indexes
ServerSignature Off
<FilesMatch "(^\.env|\.ini$|\.log$|\.sql$|composer\.(json|lock)$|package(-lock)?\.json$|config\.php$)">
  Require all denied
</FilesMatch>
<FilesMatch "^(install|setup-libs|migrate_images|fix_attendance_2026)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/x-javascript application/json image/svg+xml application/font-woff application/font-woff2 font/woff font/woff2
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|mjs|css|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|ico|woff2?|ttf|eot|mp3|wav|ogg|mp4|webm|pdf|zip)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#/(vendor/leaflet|vendor/leaflet-draw|tiles|map-tiles|maps)(/|$)#">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </If>
</IfModule>